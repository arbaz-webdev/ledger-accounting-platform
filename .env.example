# Local dev (embedded-postgres via `npm run db:start`) uses port 5433.
# Point this at any PostgreSQL 15+ instance (Docker, native, cloud) to switch.
DATABASE_URL=postgres://accounting:accounting_dev@localhost:5433/accounting
# Required to encrypt authenticator secrets (32 random bytes as 64 hex characters).
AUTH_ENCRYPTION_KEY=
# Password reset email delivery: use a verified sender with Resend.
APP_URL=https://ledger-accounting-platform.vercel.app
RESEND_API_KEY=
AUTH_EMAIL_FROM=
