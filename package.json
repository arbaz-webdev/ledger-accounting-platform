{
  "name": "accounting-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "db:start": "node scripts/db.mjs start",
    "db:stop": "node scripts/db.mjs stop",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "verify:engine": "node scripts/verify-engine.mjs",
    "test": "node --import tsx --test tests/unit.test.ts",
    "test:integration": "node --import tsx --test tests/database.test.ts",
    "test:web": "node scripts/test-web.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "decimal.js": "^10.5.0",
    "drizzle-orm": "^0.45.3",
    "next": "^15.5.26",
    "otpauth": "^9.5.2",
    "pg": "^8.16.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "dotenv": "^16.5.0",
    "embedded-postgres": "^17.10.0-beta.17",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@17.10.0-beta.17": true,
    "embedded-postgres@17.10.0-beta.17": true
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
